{
  "manifest_version": 3,
  "name": "Muse Studio Cookie ",
  "version": "1.0.0",
  "description": " muse.ai  Cookie  musestudio 。 Python、。",
  "permissions": ["cookies", "storage", "activeTab"],
  "host_permissions": [
    "https://muse.ai/*",
    "https://*.muse.ai/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Muse Studio Cookie ",
    "default_popup": "popup.html"
  }
}
